if(CSE_RUNTIME_REJECTION_CASE STREQUAL "unknown-import")
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/unowned.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "wrong-root")
  cse_link_native_runtime_import(runtime_probe Release "${CSE_SDK_DIR}/other/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "import-escape")
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/../lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "wrong-config")
  cse_link_native_runtime_import(runtime_probe Debug "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "unsupported-config")
  cse_link_native_runtime_import(runtime_probe RelWithDebInfo "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "include-escape")
  cse_native_runtime_include("${reference_prefix}/include/../lib" mapped)
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "invalid-include")
  cse_native_runtime_include("${reference_prefix}/debug/include" mapped)
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "missing-include")
  cse_native_runtime_include("${reference_prefix}/include/cse-unowned-header-tree" mapped)
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "missing-prefix")
  set(CSE_NATIVE_THIRD_PARTY_PREFIX "")
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "foreign-provider")
  cse_load_native_third_party()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/outside-native-prefix.a" "fixture")
  set_property(TARGET freetype PROPERTY IMPORTED_LOCATION_RELEASE "${CMAKE_CURRENT_BINARY_DIR}/outside-native-prefix.a")
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "interface-provider")
  add_library(freetype INTERFACE IMPORTED GLOBAL)
  add_library(Freetype::Freetype INTERFACE IMPORTED GLOBAL)
  set_property(TARGET Freetype::Freetype PROPERTY INTERFACE_LINK_LIBRARIES freetype)
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "configuration-fallback")
  cse_load_native_third_party()
  set_property(TARGET freetype PROPERTY MAP_IMPORTED_CONFIG_DEBUG Release)
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "cached-provider-change")
  cse_native_runtime_include("${reference_prefix}/include" mapped)
  set_property(TARGET freetype PROPERTY MAP_IMPORTED_CONFIG_DEBUG Release)
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "sdk-internal-symlink")
  file(REMOVE "${reference_prefix}/include/sdk-headers")
  file(CREATE_LINK "${CSE_SDK_DIR}/public" "${reference_prefix}/include/sdk-headers" SYMBOLIC)
  cse_native_runtime_include("${reference_prefix}/include/sdk-headers" mapped)
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "sdk-escape-symlink")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/outside-sdk")
  file(REMOVE "${reference_prefix}/include/escaped-headers")
  file(CREATE_LINK "${CMAKE_CURRENT_BINARY_DIR}/outside-sdk" "${reference_prefix}/include/escaped-headers" SYMBOLIC)
  cse_native_runtime_include("${reference_prefix}/include/escaped-headers" mapped)
elseif(CSE_RUNTIME_REJECTION_CASE STREQUAL "wrong-architecture")
  if(CSE_TARGET_ARCH STREQUAL arm64)
    set(CSE_TARGET_ARCH x64)
  else()
    set(CSE_TARGET_ARCH arm64)
  endif()
  cse_link_native_runtime_import(runtime_probe Release "${reference_prefix}/lib/freetype.lib")
else()
  message(FATAL_ERROR "Unknown rejection fixture: ${CSE_RUNTIME_REJECTION_CASE}")
endif()
