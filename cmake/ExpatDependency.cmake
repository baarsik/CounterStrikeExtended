include_guard(GLOBAL)

function(cse_link_form_xml target)
  if(NOT TARGET expat)
    set(materials "${CSE_ROOT}/src/external/expat-source")
    set(archive "${materials}/expat-2.8.5.tar.xz")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${archive}")
    file(SHA256 "${archive}" archive_hash)
    if(NOT archive_hash STREQUAL "1e727b8933ec51a77a9a9d9afcf8e688bce45d907c13e36ab7393fe36e703182")
      message(FATAL_ERROR "Expat source archive hash mismatch")
    endif()
    set(binary "${CMAKE_BINARY_DIR}/dependencies/form-xml")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${binary}/source")
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    foreach(option TOOLS EXAMPLES TESTS DOCS FUZZERS PKGCONFIG)
      set(EXPAT_BUILD_${option} OFF)
    endforeach()
    set(EXPAT_SHARED_LIBS OFF)
    set(EXPAT_DTD OFF)
    set(EXPAT_GE OFF)
    set(EXPAT_NS ON)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
    get_target_property(runtime ${target} MSVC_RUNTIME_LIBRARY)
    if(MSVC AND runtime AND NOT runtime MATCHES "DLL")
      set(EXPAT_MSVC_STATIC_CRT ON)
    else()
      set(EXPAT_MSVC_STATIC_CRT OFF)
    endif()
    add_subdirectory("${binary}/source/expat-2.8.5" "${binary}/upstream" EXCLUDE_FROM_ALL)
    set_target_properties(expat PROPERTIES C_VISIBILITY_PRESET hidden
      ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/$<CONFIG>/expat")
    if(CSE_STAGE_DISTRIBUTION_MATERIALS)
      add_custom_target(cse_stage_expat_materials
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${CSE_OUTPUT_DIRECTORY}/licenses/expat"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different
          "${materials}/COPYING" "${materials}/UPSTREAM.md" "${archive}"
          "${CSE_OUTPUT_DIRECTORY}/licenses/expat"
        VERBATIM COMMENT "Stage Expat distribution materials")
    endif()
  endif()
  target_link_libraries(${target} PRIVATE expat)
  if(TARGET cse_stage_expat_materials)
    add_dependencies(${target} cse_stage_expat_materials)
  endif()
endfunction()
