# Preserve game metadata's native module name without duplicating a loaded image.
if(NOT DEFINED CSE_MODULE_ALIAS OR NOT DEFINED CSE_MODULE_TARGET)
  message(FATAL_ERROR "A native module alias requires an owned path and target name")
endif()
get_filename_component(target_name "${CSE_MODULE_TARGET}" NAME)
if(NOT target_name STREQUAL CSE_MODULE_TARGET OR target_name STREQUAL "" OR
   CSE_MODULE_TARGET MATCHES "[/\\\\]")
  message(FATAL_ERROR "The module alias target must be a relative filename")
endif()
get_filename_component(alias_name "${CSE_MODULE_ALIAS}" NAME)
if(alias_name STREQUAL target_name)
  message(FATAL_ERROR "A native module alias cannot name itself")
endif()
if(IS_SYMLINK "${CSE_MODULE_ALIAS}")
  file(READ_SYMLINK "${CSE_MODULE_ALIAS}" existing_target)
  if(NOT existing_target STREQUAL CSE_MODULE_TARGET)
    message(FATAL_ERROR "Refusing to replace an unowned module symlink: ${CSE_MODULE_ALIAS}")
  endif()
elseif(EXISTS "${CSE_MODULE_ALIAS}")
  message(FATAL_ERROR "Refusing to replace an existing module file: ${CSE_MODULE_ALIAS}")
else()
  file(CREATE_LINK "${CSE_MODULE_TARGET}" "${CSE_MODULE_ALIAS}" SYMBOLIC RESULT result)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot create native module alias: ${result}")
  endif()
endif()
