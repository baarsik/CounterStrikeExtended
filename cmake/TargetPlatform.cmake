include_guard(GLOBAL)
include(CheckCXXSourceCompiles)

# Ask the selected compiler. Host processor, generator spelling and import-file
# paths cannot identify cross-compiled object code (including MSVC on ARM hosts).
function(cse_detect_compiler_architecture output)
  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
  foreach(architecture x86 x64 arm64)
    if(architecture STREQUAL x86)
      set(predicate "defined(_M_IX86) || defined(__i386__)")
    elseif(architecture STREQUAL x64)
      set(predicate "(defined(_M_X64) || defined(__x86_64__)) && !defined(_M_ARM64EC)")
    else()
      set(predicate "(defined(_M_ARM64) || defined(__aarch64__)) && !defined(_M_ARM64EC)")
    endif()
    check_cxx_source_compiles("#if !(${predicate})\n#error Wrong compiler target\n#endif\nint probe(void) { return 0; }"
      CSE_COMPILER_IS_${architecture})
    if(CSE_COMPILER_IS_${architecture})
      set(${output} "${architecture}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Unsupported compiler target; expected x86, x64 or native ARM64 (not ARM64EC)")
endfunction()

cse_detect_compiler_architecture(detected_architecture)
if(DEFINED CSE_TARGET_ARCH AND NOT CSE_TARGET_ARCH STREQUAL detected_architecture)
  message(FATAL_ERROR "Requested ${CSE_TARGET_ARCH}, but compiler target is ${detected_architecture}; initialize the matching toolchain")
endif()
set(CSE_TARGET_ARCH "${detected_architecture}")
if((CSE_TARGET_ARCH STREQUAL x86 AND NOT CMAKE_SIZEOF_VOID_P EQUAL 4) OR
    (NOT CSE_TARGET_ARCH STREQUAL x86 AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
  message(FATAL_ERROR "Compiler target architecture and pointer width disagree")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL Windows)
  set(CSE_TARGET_OS windows)
elseif(CMAKE_SYSTEM_NAME STREQUAL Darwin)
  set(CSE_TARGET_OS macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL Linux)
  set(CSE_TARGET_OS linux)
else()
  message(FATAL_ERROR "Unsupported target OS: ${CMAKE_SYSTEM_NAME}")
endif()
if(MSVC)
  set(CSE_COMPILER_ABI msvc)
  string(TOUPPER "${CSE_TARGET_ARCH}" CSE_MSVC_MACHINE)
elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
  set(CSE_COMPILER_ABI itanium)
else()
  message(FATAL_ERROR "Unsupported C++ compiler ABI: ${CMAKE_CXX_COMPILER_ID}")
endif()
message(STATUS "CSE compiler target: ${CSE_TARGET_OS}-${CSE_TARGET_ARCH}, ${CSE_COMPILER_ABI}, ${CMAKE_SIZEOF_VOID_P}-byte pointers")
