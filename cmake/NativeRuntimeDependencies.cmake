include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/NativeThirdParty.cmake")

# Retained manifest paths identify logical dependencies. They are never native
# link inputs, and neither their names nor their directories identify an ABI.
function(_cse_native_runtime_reference reference output_path output_prefix)
  if(NOT CSE_TARGET_ARCH MATCHES "^(x64|arm64)$")
    message(FATAL_ERROR "Native runtime dependency routing requires an explicit x64 or arm64 compiler target")
  endif()
  if(NOT IS_ABSOLUTE "${CSE_SDK_DIR}" OR NOT IS_DIRECTORY "${CSE_SDK_DIR}")
    message(FATAL_ERROR "Native runtime dependency routing requires the explicit CSE_SDK_DIR")
  endif()
  if(NOT IS_ABSOLUTE "${reference}" OR reference MATCHES "[;$<>]"
      OR reference MATCHES "(^|[/\\\\])\\.\\.?([/\\\\]|$)")
    message(FATAL_ERROR "Unsupported native runtime reference path: ${reference}")
  endif()
  file(REAL_PATH "${CSE_SDK_DIR}" sdk)
  cmake_path(SET sdk_spelling NORMALIZE "${CSE_SDK_DIR}")
  cmake_path(SET logical NORMALIZE "${reference}")
  cmake_path(IS_PREFIX sdk_spelling "${logical}" NORMALIZE inside_spelling)
  if(inside_spelling)
    cmake_path(RELATIVE_PATH logical BASE_DIRECTORY "${sdk_spelling}" OUTPUT_VARIABLE sdk_relative)
    cmake_path(APPEND sdk "${sdk_relative}" OUTPUT_VARIABLE logical)
  else()
    cmake_path(IS_PREFIX sdk "${logical}" NORMALIZE inside_canonical_sdk)
    if(NOT inside_canonical_sdk)
      message(FATAL_ERROR "Native runtime reference path escapes the SDK: ${reference}")
    endif()
  endif()
  # Logical archive files may be absent on a native builder. Resolve existing
  # ancestors to check symlinks without requiring or opening a Win32 archive.
  set(ancestor "${reference}")
  set(missing_components)
  while(NOT EXISTS "${ancestor}")
    if(IS_SYMLINK "${ancestor}")
      message(FATAL_ERROR "Native runtime reference has a dangling symlink: ${reference}")
    endif()
    cmake_path(GET ancestor FILENAME component)
    list(PREPEND missing_components "${component}")
    cmake_path(GET ancestor PARENT_PATH ancestor)
  endwhile()
  file(REAL_PATH "${ancestor}" resolved)
  foreach(component IN LISTS missing_components)
    cmake_path(APPEND resolved "${component}")
  endforeach()
  cmake_path(IS_PREFIX sdk "${resolved}" NORMALIZE inside_sdk)
  if(NOT inside_sdk)
    message(FATAL_ERROR "Native runtime reference path escapes the SDK: ${reference}")
  endif()
  # Mapping is based on the manifest's logical name, not a symlink target's
  # basename or directory. The resolved path is used only for containment.
  set(${output_path} "${logical}" PARENT_SCOPE)
  set(${output_prefix} "${sdk}/external/installed/x86-windows-static-md" PARENT_SCOPE)
endfunction()

function(_cse_validate_native_runtime_provider provider prefix)
  # Repeated logical imports share validated targets. Revalidate if any of the
  # provider's configuration, location, include or link properties changes.
  set(identity "${CSE_TARGET_ARCH}|${prefix}|${provider}")
  foreach(property TYPE IMPORTED INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
      INTERFACE_LINK_LIBRARIES IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG
      IMPORTED_LOCATION_NOCONFIG MAP_IMPORTED_CONFIG_RELEASE MAP_IMPORTED_CONFIG_DEBUG)
    get_target_property(value "${provider}" "${property}")
    string(APPEND identity "|${property}=${value}")
  endforeach()
  string(SHA256 key "${identity}")
  get_property(verified GLOBAL PROPERTY "CSE_NATIVE_RUNTIME_PROVIDER_${key}")
  if(NOT verified)
    cse_validate_native_import("${provider}" "${prefix}")
    set_property(GLOBAL PROPERTY "CSE_NATIVE_RUNTIME_PROVIDER_${key}" TRUE)
  endif()
endfunction()

function(_cse_load_native_runtime_dependencies output_prefix)
  if(NOT IS_ABSOLUTE "${CSE_NATIVE_THIRD_PARTY_PREFIX}"
      OR NOT IS_DIRECTORY "${CSE_NATIVE_THIRD_PARTY_PREFIX}/share")
    message(FATAL_ERROR "Select an explicit source-built CSE_NATIVE_THIRD_PARTY_PREFIX")
  endif()
  file(REAL_PATH "${CSE_NATIVE_THIRD_PARTY_PREFIX}" prefix)
  get_property(previous_prefix GLOBAL PROPERTY CSE_NATIVE_RUNTIME_DEPENDENCY_PREFIX)
  if(previous_prefix AND NOT previous_prefix STREQUAL prefix)
    message(FATAL_ERROR "Native runtime dependency provider prefix changed after package import")
  endif()

  cse_load_native_third_party()
  # Interface wrappers alone cannot establish a binary provider's identity.
  # Check their concrete archives as well, including already-imported targets.
  set(providers freetype BZip2::BZip2 PNG::png_static ZLIB::ZLIB
    unofficial::brotli::brotlicommon unofficial::brotli::brotlidec expat::expat
    Ogg::ogg Vorbis::vorbis Vorbis::vorbisfile unofficial::libvpx::libvpx unofficial::libwebm::libwebm)
  foreach(provider IN LISTS providers)
    if(NOT TARGET "${provider}")
      message(FATAL_ERROR "Unknown native runtime dependency provider: ${provider}")
    endif()
    get_target_property(imported "${provider}" IMPORTED)
    get_target_property(kind "${provider}" TYPE)
    if(NOT imported OR NOT kind MATCHES "^(STATIC_LIBRARY|UNKNOWN_LIBRARY)$")
      message(FATAL_ERROR "Unknown native runtime dependency provider: ${provider} (${kind})")
    endif()
    _cse_validate_native_runtime_provider("${provider}" "${prefix}")
  endforeach()
  foreach(pair "Freetype::Freetype|freetype" "PNG::PNG|PNG::png_static")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 wrapper)
    list(GET parts 1 archive)
    if(NOT TARGET "${wrapper}")
      message(FATAL_ERROR "Unknown native runtime dependency provider: ${wrapper}")
    endif()
    get_target_property(linked "${wrapper}" INTERFACE_LINK_LIBRARIES)
    if(NOT linked STREQUAL archive)
      message(FATAL_ERROR "Unknown native runtime dependency provider behind ${wrapper}: ${linked}")
    endif()
    _cse_validate_native_runtime_provider("${wrapper}" "${prefix}")
  endforeach()
  set_property(GLOBAL PROPERTY CSE_NATIVE_RUNTIME_DEPENDENCY_PREFIX "${prefix}")
  set(${output_prefix} "${prefix}" PARENT_SCOPE)
endfunction()

function(cse_link_native_runtime_import target configuration reference_path)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Unknown native runtime consumer: ${target}")
  endif()
  if(configuration STREQUAL "Release")
    set(directory lib)
    set(names freetype.lib bz2.lib libexpatMD.lib libpng16.lib zs.lib
      brotlicommon.lib brotlidec.lib ogg.lib vorbis.lib vorbisfile.lib vpx.lib webm.lib)
  elseif(configuration STREQUAL "Debug")
    set(directory debug/lib)
    set(names freetyped.lib bz2d.lib libexpatdMD.lib libpng16d.lib zsd.lib
      brotlicommon.lib brotlidec.lib ogg.lib vorbis.lib vorbisfile.lib vpx.lib webm.lib)
  else()
    message(FATAL_ERROR "Unsupported native runtime import configuration: ${configuration}")
  endif()
  _cse_native_runtime_reference("${reference_path}" reference prefix)
  cmake_path(RELATIVE_PATH reference BASE_DIRECTORY "${prefix}" OUTPUT_VARIABLE relative)
  cmake_path(GET reference FILENAME name)
  list(FIND names "${name}" index)
  if(index LESS 0 OR NOT relative STREQUAL "${directory}/${name}")
    message(FATAL_ERROR "Unknown ${configuration} native runtime logical import: ${reference_path}")
  endif()
  set(providers Freetype::Freetype BZip2::BZip2 expat::expat PNG::PNG ZLIB::ZLIB
    unofficial::brotli::brotlicommon unofficial::brotli::brotlidec Ogg::ogg
    Vorbis::vorbis Vorbis::vorbisfile unofficial::libvpx::libvpx unofficial::libwebm::libwebm)
  list(GET providers ${index} provider)
  _cse_load_native_runtime_dependencies(native_prefix)
  target_link_libraries(${target} PRIVATE "$<$<CONFIG:${configuration}>:${provider}>")
endfunction()

function(cse_native_runtime_include reference_include output_var)
  _cse_native_runtime_reference("${reference_include}" reference prefix)
  cmake_path(IS_PREFIX prefix "${reference}" NORMALIZE retained_dependency)
  if(NOT retained_dependency)
    # Preserve other SDK include paths byte-for-byte; source membership and
    # configuration guards remain the responsibility of the retained manifest.
    set(${output_var} "${reference_include}" PARENT_SCOPE)
    return()
  endif()
  cmake_path(RELATIVE_PATH reference BASE_DIRECTORY "${prefix}" OUTPUT_VARIABLE relative)
  if(NOT relative MATCHES "^include(/(.*))?$")
    message(FATAL_ERROR "Unsupported retained dependency include: ${reference_include}")
  endif()
  set(suffix "${CMAKE_MATCH_2}")
  _cse_load_native_runtime_dependencies(native_prefix)
  set(include_prefix "${native_prefix}/include")
  set(candidate "${include_prefix}/${suffix}")
  if(NOT IS_DIRECTORY "${candidate}")
    message(FATAL_ERROR "Native runtime include is missing or escapes the pinned prefix: ${reference_include}")
  endif()
  file(REAL_PATH "${candidate}" native_include)
  cmake_path(IS_PREFIX include_prefix "${native_include}" NORMALIZE inside_native_include)
  if(NOT inside_native_include OR NOT IS_DIRECTORY "${native_include}")
    message(FATAL_ERROR "Native runtime include is missing or escapes the pinned prefix: ${reference_include}")
  endif()
  set(${output_var} "${native_include}" PARENT_SCOPE)
endfunction()
