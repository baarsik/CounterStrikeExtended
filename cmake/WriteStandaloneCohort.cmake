foreach(required CSE_VGUI2 CSE_FILESYSTEM CSE_HEADER)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing standalone cohort input ${required}")
  endif()
endforeach()
file(SHA256 "${CSE_VGUI2}" vgui_hash)
file(SHA256 "${CSE_FILESYSTEM}" filesystem_hash)
set(contents "#pragma once\nnamespace cse_standalone_images {\n")
string(APPEND contents "constexpr char VguiSha256[] = \"${vgui_hash}\";\n")
string(APPEND contents "constexpr char FilesystemSha256[] = \"${filesystem_hash}\";\n}\n")
get_filename_component(directory "${CSE_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${CSE_HEADER}.tmp" "${contents}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CSE_HEADER}.tmp" "${CSE_HEADER}"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${CSE_HEADER}.tmp")
