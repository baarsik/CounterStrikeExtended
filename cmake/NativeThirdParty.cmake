include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/BinaryArchitecture.cmake")
set(CSE_NATIVE_THIRD_PARTY_PREFIX "" CACHE PATH "Pinned source-built dependency install prefix")

function(cse_validate_native_import dependency prefix)
  file(REAL_PATH "${prefix}" prefix)
  get_target_property(kind "${dependency}" TYPE)
  if(kind STREQUAL "EXECUTABLE")
    return() # Host tools are not runtime link inputs.
  endif()
  if(NOT kind STREQUAL "INTERFACE_LIBRARY")
    foreach(configuration DEBUG RELEASE)
      get_property(mapped TARGET "${dependency}" PROPERTY "MAP_IMPORTED_CONFIG_${configuration}" SET)
      if(mapped)
        get_target_property(mapping "${dependency}" "MAP_IMPORTED_CONFIG_${configuration}")
        string(TOUPPER "${mapping}" mapping)
        if(NOT mapping STREQUAL configuration)
          message(FATAL_ERROR "${dependency}: unsupported ${configuration} import configuration mapping: ${mapping}")
        endif()
      endif()
      get_target_property(location "${dependency}" "IMPORTED_LOCATION_${configuration}")
      if(NOT location)
        message(FATAL_ERROR "${dependency}: missing explicit ${configuration} import; fallback is not permitted")
      endif()
    endforeach()
  endif()
  foreach(property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    get_target_property(headers "${dependency}" "${property}")
    if(headers)
      foreach(header IN LISTS headers)
        file(REAL_PATH "${header}" resolved)
        set(header_prefix "${prefix}/include")
        cmake_path(IS_PREFIX header_prefix "${resolved}" NORMALIZE inside)
        if(NOT inside OR NOT IS_DIRECTORY "${resolved}")
          message(FATAL_ERROR "${dependency}: native dependency header directory is outside the pinned prefix: ${header}")
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(property IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG IMPORTED_LOCATION_NOCONFIG)
    get_target_property(location "${dependency}" "${property}")
    if(location)
      file(REAL_PATH "${location}" resolved)
      set(required_prefix "${prefix}")
      if(property STREQUAL "IMPORTED_LOCATION_DEBUG")
        set(required_prefix "${prefix}/debug/lib")
      elseif(property STREQUAL "IMPORTED_LOCATION_RELEASE")
        set(required_prefix "${prefix}/lib")
      endif()
      cmake_path(IS_PREFIX required_prefix "${resolved}" NORMALIZE inside)
      if(NOT inside)
        message(FATAL_ERROR "${dependency} resolves outside the native dependency prefix: ${location}")
      endif()
      cse_verify_binary("${location}" "${CSE_TARGET_ARCH}")
    endif()
  endforeach()
endfunction()

function(cse_load_native_third_party)
  if(TARGET cse_native_media)
    return()
  endif()
  get_directory_property(previous_imports IMPORTED_TARGETS)
  if(NOT CSE_TARGET_ARCH OR NOT IS_DIRECTORY "${CSE_NATIVE_THIRD_PARTY_PREFIX}/share")
    message(FATAL_ERROR "Select the compiler target and a source-built CSE_NATIVE_THIRD_PARTY_PREFIX")
  endif()
  file(REAL_PATH "${CSE_NATIVE_THIRD_PARTY_PREFIX}" prefix)
  foreach(configuration lib debug/lib)
    file(GLOB archives CONFIGURE_DEPENDS "${prefix}/${configuration}/*.a" "${prefix}/${configuration}/*.lib")
    if(NOT archives)
      message(FATAL_ERROR "Missing native dependency archives: ${prefix}/${configuration}")
    endif()
    foreach(archive IN LISTS archives)
      cse_verify_binary("${archive}" "${CSE_TARGET_ARCH}")
    endforeach()
  endforeach()

  # Resolve configs in this prefix, including their find_dependency calls. The
  # imported locations below are checked again to reject cached host libraries.
  list(PREPEND CMAKE_PREFIX_PATH "${prefix}")
  set(CMAKE_FIND_PACKAGE_PREFER_CONFIG TRUE)
  find_package(ZLIB CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/zlib" NO_DEFAULT_PATH)
  if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS ZLIB::ZLIBSTATIC)
  endif()
  # FindBZip2 does not search vcpkg's debug/lib layout. Resolve both
  # configurations explicitly, allowing either documented library basename.
  find_library(BZIP2_LIBRARY_RELEASE NAMES bz2 bzip2 libbz2 libbzip2
    PATHS "${prefix}/lib" NO_DEFAULT_PATH REQUIRED)
  find_library(BZIP2_LIBRARY_DEBUG NAMES bz2d bzip2d libbz2d libbzip2d bz2 bzip2 libbz2 libbzip2
    PATHS "${prefix}/debug/lib" NO_DEFAULT_PATH REQUIRED)
  find_path(BZIP2_INCLUDE_DIR NAMES bzlib.h PATHS "${prefix}/include" NO_DEFAULT_PATH REQUIRED)
  find_package(BZip2 REQUIRED GLOBAL)
  find_package(PNG CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/png" NO_DEFAULT_PATH)
  find_package(unofficial-brotli CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/unofficial-brotli" NO_DEFAULT_PATH)
  find_package(expat CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/expat" NO_DEFAULT_PATH)
  find_package(freetype CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/freetype" NO_DEFAULT_PATH)
  find_package(Ogg CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/ogg" NO_DEFAULT_PATH)
  find_package(Vorbis CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/Vorbis" NO_DEFAULT_PATH)
  find_package(unofficial-libvpx CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/unofficial-libvpx" NO_DEFAULT_PATH)
  find_package(unofficial-libwebm CONFIG REQUIRED GLOBAL PATHS "${prefix}/share/unofficial-libwebm" NO_DEFAULT_PATH)

  set(libraries ZLIB::ZLIB BZip2::BZip2 PNG::PNG unofficial::brotli::brotlienc
    unofficial::brotli::brotlidec expat::expat Freetype::Freetype Ogg::ogg
    Vorbis::vorbisfile Vorbis::vorbisenc unofficial::libvpx::libvpx unofficial::libwebm::libwebm)
  get_directory_property(imports IMPORTED_TARGETS)
  list(REMOVE_ITEM imports ${previous_imports})
  list(APPEND imports ${libraries} freetype)
  list(REMOVE_DUPLICATES imports)
  foreach(dependency IN LISTS imports)
    cse_validate_native_import("${dependency}" "${prefix}")
  endforeach()
  add_library(cse_native_media INTERFACE)
  target_link_libraries(cse_native_media INTERFACE ${libraries})
endfunction()
