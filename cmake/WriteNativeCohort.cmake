foreach(required CSE_ENGINE CSE_VGUI CSE_HEADER)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing native cohort input ${required}")
  endif()
endforeach()
file(SHA256 "${CSE_ENGINE}" engine_hash)
file(SHA256 "${CSE_VGUI}" vgui_hash)
set(software_hash "")
if(DEFINED CSE_SOFTWARE_ENGINE AND NOT CSE_SOFTWARE_ENGINE STREQUAL "")
  file(SHA256 "${CSE_SOFTWARE_ENGINE}" software_hash)
endif()
set(contents "#pragma once\nnamespace cse_native_cohort {\n")
string(APPEND contents "constexpr char EngineSha256[] = \"${engine_hash}\";\n")
string(APPEND contents "constexpr char SoftwareEngineSha256[] = \"${software_hash}\";\n")
string(APPEND contents "constexpr char VguiSha256[] = \"${vgui_hash}\";\n}\n")
get_filename_component(directory "${CSE_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${CSE_HEADER}.tmp" "${contents}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${CSE_HEADER}.tmp" "${CSE_HEADER}"
  COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${CSE_HEADER}.tmp")
