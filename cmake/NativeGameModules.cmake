# An explicit component entry point. This does not enable a native whole-game build.
include("${CSE_ROOT}/cmake/PlatformDefaults.cmake")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CSE_ROOT}/cmake/MSVCDefaults.cmake")
project(CounterStrikeExtendedGameModules VERSION 0.1 LANGUAGES C CXX)
include("${CSE_ROOT}/cmake/TargetPlatform.cmake")
if(NOT (MSVC AND CSE_TARGET_OS STREQUAL windows) AND
   NOT (CSE_TARGET_OS STREQUAL macos AND CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang)$"))
  message(FATAL_ERROR "Game module components currently support Windows MSVC and macOS Clang")
endif()
if(CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_CONFIGURATION_TYPES "Debug;Release" CACHE STRING "Supported configurations" FORCE)
elseif(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Debug or Release" FORCE)
elseif(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release)$")
  message(FATAL_ERROR "Only Debug and Release are supported")
endif()
set(CSE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/runtime/$<CONFIG>" CACHE STRING "Isolated game module output root")
include("${CSE_ROOT}/cmake/RuntimeTargets.cmake")
set(game_targets hl_server cs_server)
foreach(target IN LISTS game_targets)
  add_subdirectory("${CSE_ROOT}/cmake/targets/${target}" "${CMAKE_BINARY_DIR}/targets/${target}")
endforeach()
add_custom_target(cse_game_modules DEPENDS ${game_targets})
message(STATUS "Game module component outputs: ${CSE_OUTPUT_DIRECTORY}")
message(STATUS "Only owned server libraries are built; gameplay, provider and network qualification remain separate")
