{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CSE_BUILD_DEDICATED": "ON",
        "CSE_BUILD_BROADCASTING": "ON",
        "CSE_BUILD_A3D": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "runtime-x86-release"
    },
    {
      "name": "runtime-x86-release",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "runtime-x86-debug",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "hardware-x86-release",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/hardware-release"
    },
    {
      "name": "hardware-x86-debug",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/hardware-debug"
    },
    {
      "name": "native-dependencies",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CSE_DEPENDENCIES_ONLY": "ON"
      }
    },
    {
      "name": "deps-windows-x64-release",
      "displayName": "Native dependencies only: windows x64 release",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSE_TARGET_ARCH": "x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "deps-windows-x64-debug",
      "displayName": "Native dependencies only: windows x64 debug",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSE_TARGET_ARCH": "x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "deps-windows-arm64-release",
      "displayName": "Native dependencies only: windows arm64 release",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-windows-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSE_TARGET_ARCH": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "deps-windows-arm64-debug",
      "displayName": "Native dependencies only: windows arm64 debug",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-windows-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSE_TARGET_ARCH": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "deps-macos-arm64-release",
      "displayName": "Native dependencies only: macos arm64 release",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSE_TARGET_ARCH": "arm64",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "deps-macos-arm64-debug",
      "displayName": "Native dependencies only: macos arm64 debug",
      "inherits": "native-dependencies",
      "binaryDir": "${sourceDir}/build/deps-macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSE_TARGET_ARCH": "arm64",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "runtime-x86-release",
      "configurePreset": "runtime-x86-release"
    },
    {
      "name": "runtime-x86-debug",
      "configurePreset": "runtime-x86-debug"
    },
    {
      "name": "hardware-x86-release",
      "configurePreset": "hardware-x86-release"
    },
    {
      "name": "hardware-x86-debug",
      "configurePreset": "hardware-x86-debug"
    },
    {
      "name": "deps-windows-x64-release",
      "configurePreset": "deps-windows-x64-release"
    },
    {
      "name": "deps-windows-x64-debug",
      "configurePreset": "deps-windows-x64-debug"
    },
    {
      "name": "deps-windows-arm64-release",
      "configurePreset": "deps-windows-arm64-release"
    },
    {
      "name": "deps-windows-arm64-debug",
      "configurePreset": "deps-windows-arm64-debug"
    },
    {
      "name": "deps-macos-arm64-release",
      "configurePreset": "deps-macos-arm64-release"
    },
    {
      "name": "deps-macos-arm64-debug",
      "configurePreset": "deps-macos-arm64-debug"
    }
  ]
}
