{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x86",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CSE_BUILD_DEDICATED": "ON",
        "CSE_BUILD_BROADCASTING": "ON",
        "CSE_BUILD_A3D": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "runtime-x86-release"
    },
    {
      "name": "runtime-x86-release",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "runtime-x86-debug",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "hardware-x86-release",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "binaryDir": "${sourceDir}/build/hardware-release"
    },
    {
      "name": "hardware-x86-debug",
      "inherits": "windows-x86",
      "cacheVariables": {
        "CSE_HARDWARE_ONLY": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/build/hardware-debug"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "runtime-x86-release",
      "configurePreset": "runtime-x86-release"
    },
    {
      "name": "runtime-x86-debug",
      "configurePreset": "runtime-x86-debug"
    },
    {
      "name": "hardware-x86-release",
      "configurePreset": "hardware-x86-release"
    },
    {
      "name": "hardware-x86-debug",
      "configurePreset": "hardware-x86-debug"
    }
  ]
}
