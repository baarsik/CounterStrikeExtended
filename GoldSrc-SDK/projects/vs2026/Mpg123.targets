<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CseBuildMpg123" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'Win32'" Text="The current mpg123 build contract requires Windows x86/Win32." />
    <Error Condition="'$(PlatformToolset)' != 'v145'" Text="The current mpg123 build contract requires MSVC v145." />
    <Error Condition="'$(CseMpg123Version)' != '1.33.7'" Text="mpg123 requires the pinned 1.33.7 props." />
    <Exec Command="cmake -S &quot;$(CseMpg123CmakeSource)&quot; -B &quot;$(CseMpg123BuildRoot).&quot; -G &quot;Visual Studio 18 2026&quot; -A Win32 -T v145 -DCMAKE_SYSTEM_VERSION=10.0.26100.0" />
    <Exec Command="cmake --build &quot;$(CseMpg123BuildRoot).&quot; --config $(Configuration) --target cse_mpg123 --parallel 4" />
  </Target>
  <Target Name="CseStageMpg123" AfterTargets="Build" DependsOnTargets="CseBuildMpg123">
    <MakeDir Directories="$(CseMpg123RuntimeRoot)" />
    <Copy SourceFiles="$(CseMpg123RuntimeDll)" DestinationFolder="$(CseMpg123RuntimeRoot)" SkipUnchangedFiles="true" Retries="5" RetryDelayMilliseconds="200" />
    <MakeDir Directories="$(CseMpg123RuntimeRoot)licenses\mpg123" />
    <Copy SourceFiles="$(GameRoot)external\mpg123\COPYING;$(GameRoot)external\mpg123\AUTHORS;$(GameRoot)external\mpg123\UPSTREAM.md;$(CseMpg123Archive)" DestinationFolder="$(CseMpg123RuntimeRoot)licenses\mpg123" SkipUnchangedFiles="true" />
  </Target>
</Project>
