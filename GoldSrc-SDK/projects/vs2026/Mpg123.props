<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CseMpg123Version>1.33.7</CseMpg123Version>
    <CseMpg123Archive>$(GameRoot)external\mpg123\mpg123-1.33.7.tar.bz2</CseMpg123Archive>
    <CseMpg123BuildRoot>$(IntDir)mpg123\</CseMpg123BuildRoot>
    <CseMpg123Source>$(CseMpg123BuildRoot)source\mpg123-1.33.7\</CseMpg123Source>
    <CseMpg123Include>$(CseMpg123Source)src\include</CseMpg123Include>
    <CseMpg123ImportLibrary>$(CseMpg123BuildRoot)lib\$(Configuration)\mpg123\mpg123.lib</CseMpg123ImportLibrary>
    <CseMpg123RuntimeDll>$(CseMpg123BuildRoot)runtime\$(Configuration)\mpg123.dll</CseMpg123RuntimeDll>
    <CseMpg123RuntimeRoot>$(GameRoot)bin\Win32\$(Configuration)\</CseMpg123RuntimeRoot>
    <CseMpg123CmakeSource>$(GameRoot)..\cmake\dependencies\mpg123</CseMpg123CmakeSource>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>LINK_MPG123_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(CseMpg123Include);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(CseMpg123ImportLibrary);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
