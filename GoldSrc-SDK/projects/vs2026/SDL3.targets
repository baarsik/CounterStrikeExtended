<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CseValidateSdl3" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'Win32'" Text="SDL3 requires Windows x86/Win32." />
    <Error Condition="'$(CseSdl3Version)' != '3.4.20'" Text="SDL3 requires the pinned 3.4.20 props." />
    <Error Condition="'$(CseSdl3Shared)' != 'true' and '$(CseSdl3Shared)' != 'false'" Text="CseSdl3Shared must be true or false." />
    <Error Condition="!Exists('$(CseSdl3Manifest)')" Text="Missing SDL3 payload manifest: $(CseSdl3Manifest)" />
    <GetFileHash Files="$(CseSdl3Manifest)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CseSdl3ManifestHash" />
    </GetFileHash>
    <Error Condition="'$(_CseSdl3ManifestHash)' != '75af41d550d677be367a481d95f1adc5145a331cc2c08abcf05fdb83908ddc9a'" Text="SDL3 payload manifest hash mismatch." />
    <ReadLinesFromFile File="$(CseSdl3Manifest)">
      <Output TaskParameter="Lines" ItemName="_CseSdl3ManifestLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CseSdl3Payload Include="$(CseSdl3Root)$([System.String]::Copy('%(_CseSdl3ManifestLine.Identity)').Substring(65))">
        <ExpectedHash>$([System.String]::Copy('%(_CseSdl3ManifestLine.Identity)').Substring(0, 64))</ExpectedHash>
      </_CseSdl3Payload>
    </ItemGroup>
    <Error Condition="!Exists('%(_CseSdl3Payload.Identity)')" Text="Missing SDL3 payload: %(_CseSdl3Payload.Identity)" />
    <GetFileHash Files="@(_CseSdl3Payload)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CseSdl3HashedPayload" />
    </GetFileHash>
    <Error Condition="'%(_CseSdl3HashedPayload.FileHash)' != '%(_CseSdl3HashedPayload.ExpectedHash)'" Text="SDL3 hash mismatch: %(_CseSdl3HashedPayload.Identity)" />
  </Target>
  <Target Name="CseStageSdl3" AfterTargets="Build" DependsOnTargets="CseValidateSdl3" Condition="'$(CseSdl3Shared)' == 'true'">
    <MakeDir Directories="$(CseSdl3RuntimeRoot)" />
    <Copy SourceFiles="$(CseSdl3RuntimeDll)" DestinationFolder="$(CseSdl3RuntimeRoot)" SkipUnchangedFiles="true" Retries="5" RetryDelayMilliseconds="200" />
  </Target>
</Project>
