# The selected official SDL3 payload must preserve its upstream bytes on Windows.
src/external/SDL3/** -text
src/external/mpg123/** -text
# Imported translation text retains upstream spacing; maintained files are UTF-8/LF.
src/deploy/localization/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Retain inherited source files' CRLF without flagging CR as trailing whitespace.
src/engine/cmd.cpp whitespace=cr-at-eol
src/engine/thread.cpp whitespace=cr-at-eol
src/engine/thread.h whitespace=cr-at-eol
src/vgui2/controls/RadioButton.cpp whitespace=cr-at-eol
src/cstrike/vgui2/controls/RadioButton.cpp whitespace=cr-at-eol

# Retained Windows admin layouts keep their original CRLF encoding.
src/deploy/platform/Admin/*.res whitespace=cr-at-eol
src/deploy/zbot/cstrike/resource/*.res whitespace=cr-at-eol
